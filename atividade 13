def maior_subsequencia_continua(nums):
    if not nums:
        return 0

    max_len = 1
    current_len = 1

    for i in range(1, len(nums)):
        if nums[i] > nums[i - 1]:
            current_len += 1
            max_len = max(max_len, current_len)
        else:
            current_len = 1

    return max_len


numeros = [1, 3, 5, 4, 7, 8, 9, 10, 2]
resultado = maior_subsequencia_continua(numeros)
print(f"Tamanho da maior subsequência crescente contínua: {resultado}")
