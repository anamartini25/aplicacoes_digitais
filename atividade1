valor = int(input("Digite um valor inteiro: "))
divisores = []

for i in range(1, valor + 1):
    if valor % i == 0:
        divisores.append(i)
        if valor in divisores:
            divisores.remove(valor)

# print(f"Os divisores sao: {divisores}")

numperf = sum(divisores)

if numperf == valor:
    print("Este é um número perfeito.")

else:
    print("Este não é um número perfeito.")
